#!/bin/sh
# A stand-in for the omarchy-broadcast CLI, for tests/harness/shell.qml. Never
# talks to D-Bus or to a real daemon.
#
# Every invocation appends one line to $FAKE_OB_DIR/log:
#   <pid> [arg1] [arg2] ...
#
# `watch --json`: prints every line of $FAKE_OB_DIR/snapshot (the harness puts
# the "current" snapshot there, plus any hostile lines it wants delivered at
# connection), then follows $FAKE_OB_DIR/feed from its end at start-up,
# printing each line appended to it. The start offset is taken before the
# snapshot is printed, so a line appended once the snapshot has been seen is
# never missed. Exits 0 on SIGTERM/SIGINT, as the real CLI does.
#   - if $FAKE_OB_DIR/snapshot.1 exists, it is written first, then after a
#     pause $FAKE_OB_DIR/snapshot.2: two separate writes, so the reader gets
#     two reads (a line, or a character, cut across a read boundary);
#   - if $FAKE_OB_DIR/watch-exit exists, the watch exits with that status
#     right after the snapshot (a watch that dies after connecting).
#   - camera image controls: if $FAKE_OB_DIR/controls-mode exists, every
#     snapshot line it prints (from snapshot or feed) that has no
#     camera_controls field gets one, by the mode's first word:
#       absent  none (a CLI that predates the controls)
#       null    "camera_controls":null (a daemon below interface revision 6)
#       list    {"camera":C,"controls":[...]} from controls-state (no lines:
#               an empty list; leave a control out: a camera lacking it)
#     where controls-state holds one control per line,
#     `name min max step default value stored` (stored 0 or 1), and C is the
#     first line of controls-camera. The harness's own snapshot lines may
#     carry the field themselves; those are printed as they are.
#
# `preview --json [--fps 15|30]`: as the real CLI's preview stream, without a
# daemon. Any other fps (or argument) is a usage error, exit 2. It writes into
# $XDG_RUNTIME_DIR/omarchy-broadcast/preview.jpg, and refuses (exit 3) any
# XDG_RUNTIME_DIR but the harness's scratch one, $FAKE_OB_DIR/../runtime, so
# the user's real runtime directory is never written. It prints:
#   - the lines of $FAKE_OB_DIR/preview-error, if it exists (an outage);
#   - `{"v":1,"type":"preview","active":true,"fps":N,"path":P}`;
#   - the lines of $FAKE_OB_DIR/preview-hostile, if it exists;
#   - if $FAKE_OB_DIR/preview-exit exists, exits with that status here;
#   - then forever, at the fps: copies the next of $FAKE_OB_DIR/frames/0..3.jpg
#     (real JPEGs, made by run-harness.sh) to P.tmp, renames it onto P, and
#     prints `{"v":1,"type":"frame","seq":N,"path":P}`, seq from 1.
# On SIGTERM/SIGINT/SIGHUP it removes the frame files and exits 0.
#
# `controls set NAME VALUE` and `controls reset`: as the other commands below
# (delay, stderr, exit), after a usage check (exit 2: wrong arguments, or a
# VALUE that is not a decimal integer). When the exit status is 0 and
# controls-state exists, it is the daemon: an unknown NAME or a VALUE out of
# range is refused (exit 1, a message on stderr); otherwise the value is
# stored (reset: every value back to its default, nothing stored) and the
# new `controls` line is appended to the feed, as the daemon's signal would
# reach a watch. Without controls-state the harness writes the reaction.
#
# Any other command (`on`, `off`, `camera -- <id>`, `camera next`,
# `effect none|blur|replace`, `denoise on|off`): sleeps $FAKE_OB_DIR/delay
# seconds if that file exists, prints $FAKE_OB_DIR/stderr to stderr if it
# exists, and exits with the status in $FAKE_OB_DIR/exit (default 0). It
# changes no state: the harness writes the daemon's reaction (a state line
# with `effect`, `blur_strength`, `background_image` and `denoise`, as the
# real CLI prints) to the feed itself, and puts `denoise` in its snapshots
# (or leaves it out, for a CLI that predates noise removal).
set -u

dir=${FAKE_OB_DIR:?FAKE_OB_DIR is not set}
log=$dir/log

{
  printf '%s' "$$"
  for arg in "$@"; do printf ' [%s]' "$arg"; done
  printf '\n'
} >> "$log"

# The controls of controls-state as the CLI prints them:
# {"camera":C,"controls":[...]}.
controls_object() {
  camera=$(head -n 1 -- "$dir/controls-camera" 2>/dev/null || true)
  awk -v camera="$camera" '
    BEGIN { printf "{\"camera\":\"%s\",\"controls\":[", camera; sep = "" }
    NF == 7 {
      printf "%s{\"name\":\"%s\",\"min\":%s,\"max\":%s,\"step\":%s,\"default\":%s,\"value\":%s,\"stored\":%s}",
        sep, $1, $2, $3, $4, $5, $6, ($7 == 1 ? "true" : "false")
      sep = ","
    }
    END { printf "]}" }' "$dir/controls-state" 2>/dev/null
}

# stdin -> stdout, adding camera_controls to snapshot lines per controls-mode.
with_controls() {
  mode=$(head -n 1 -- "$dir/controls-mode" 2>/dev/null || echo absent)
  case $mode in
    null) add=',"camera_controls":null' ;;
    list) add=',"camera_controls":'$(controls_object) ;;
    *) add="" ;;
  esac
  if [ -z "$add" ]; then
    cat
  else
    # ENVIRON, not -v: awk would read backslash escapes in a -v value.
    ADD=$add awk '/"type":"snapshot"/ && !/"camera_controls"/ { sub(/}$/, ""); $0 = $0 ENVIRON["ADD"] "}" } { print }'
  fi
}

if [ "${1:-}" = "watch" ] && [ "${2:-}" = "--json" ]; then
  trap 'exit 0' TERM INT
  feed=$dir/feed
  touch "$feed"
  n=$(wc -l < "$feed")
  if [ -f "$dir/snapshot.1" ]; then
    cat "$dir/snapshot.1"
    sleep 0.3
    cat "$dir/snapshot.2" 2>/dev/null
  fi
  if [ -f "$dir/snapshot" ]; then
    if [ -f "$dir/controls-mode" ]; then with_controls < "$dir/snapshot"; else cat "$dir/snapshot"; fi
  fi
  [ -f "$dir/watch-exit" ] && exit "$(cat "$dir/watch-exit")"
  while :; do
    total=$(wc -l < "$feed")
    while [ "$n" -lt "$total" ]; do
      n=$((n + 1))
      if [ -f "$dir/controls-mode" ]; then sed -n "${n}p" "$feed" | with_controls; else sed -n "${n}p" "$feed"; fi
    done
    sleep 0.05
  done
fi

if [ "${1:-}" = "controls" ]; then
  case ${2:-} in
    set)
      [ $# -eq 4 ] || { echo "fake: usage: controls set NAME VALUE" >&2; exit 2; }
      case $4 in
        ''|-|*[!0-9-]*|?*-*) echo "fake: invalid value '$4' for '<VALUE>'" >&2; exit 2 ;;
      esac ;;
    reset)
      [ $# -eq 2 ] || { echo "fake: usage: controls reset" >&2; exit 2; } ;;
    *) echo "fake: usage: controls set NAME VALUE | controls reset" >&2; exit 2 ;;
  esac
  [ -f "$dir/delay" ] && sleep "$(cat "$dir/delay")"
  [ -f "$dir/stderr" ] && cat "$dir/stderr" >&2
  status=0
  [ -f "$dir/exit" ] && status=$(cat "$dir/exit")
  [ "$status" -eq 0 ] && [ -f "$dir/controls-state" ] || exit "$status"
  state=$dir/controls-state
  if [ "$2" = set ]; then
    awk -v name="$3" -v value="$4" '
      NF == 7 && $1 == name { found = 1; if (value + 0 < $2 + 0 || value + 0 > $3 + 0) bad = 1; $6 = value + 0; $7 = 1 }
      { print }
      END { exit (!found ? 3 : (bad ? 4 : 0)) }' "$state" > "$state.tmp"
    case $? in
      0) ;;
      3) rm -f -- "$state.tmp"; echo "omarchy-broadcast: the camera has no control $3" >&2; exit 1 ;;
      *) rm -f -- "$state.tmp"; echo "omarchy-broadcast: $4 is out of range for $3" >&2; exit 1 ;;
    esac
  else
    awk 'NF == 7 { $6 = $5; $7 = 0 } { print }' "$state" > "$state.tmp"
  fi
  mv -f -- "$state.tmp" "$state"
  printf '{"v":1,"type":"controls",%s\n' "$(controls_object | sed 's/^{//')" >> "$dir/feed"
  exit 0
fi

if [ "${1:-}" = "preview" ]; then
  [ "${2:-}" = "--json" ] || { echo "fake: preview needs --json" >&2; exit 2; }
  fps=15
  if [ $# -gt 2 ]; then
    [ $# -eq 4 ] && [ "$3" = "--fps" ] || { echo "fake: usage: preview --json [--fps 15|30]" >&2; exit 2; }
    fps=$4
  fi
  case $fps in
    15) delay=0.066 ;;
    30) delay=0.033 ;;
    *) echo "fake: invalid value '$fps' for '--fps'" >&2; exit 2 ;;
  esac
  rt=${XDG_RUNTIME_DIR:-}
  [ -n "$rt" ] && [ "$rt" = "$(dirname -- "$dir")/runtime" ] || { echo "fake: refusing XDG_RUNTIME_DIR=$rt" >&2; exit 3; }
  out=$rt/omarchy-broadcast
  mkdir -p -- "$out" && chmod 700 -- "$out" || exit 1
  path=$out/preview.jpg
  trap 'rm -f -- "$path" "$path.tmp"; exit 0' TERM INT HUP
  [ -f "$dir/preview-error" ] && cat "$dir/preview-error"
  printf '{"v":1,"type":"preview","active":true,"fps":%s,"path":"%s"}\n' "$fps" "$path"
  [ -f "$dir/preview-hostile" ] && cat "$dir/preview-hostile"
  [ -f "$dir/preview-exit" ] && exit "$(cat "$dir/preview-exit")"
  n=0
  while :; do
    n=$((n + 1))
    cp -- "$dir/frames/$((n % 4)).jpg" "$path.tmp" && mv -f -- "$path.tmp" "$path" || exit 1
    printf '{"v":1,"type":"frame","seq":%s,"path":"%s"}\n' "$n" "$path"
    sleep "$delay"
  done
fi

[ -f "$dir/delay" ] && sleep "$(cat "$dir/delay")"
[ -f "$dir/stderr" ] && cat "$dir/stderr" >&2
status=0
[ -f "$dir/exit" ] && status=$(cat "$dir/exit")
exit "$status"
