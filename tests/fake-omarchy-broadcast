#!/bin/sh
# A stand-in for the omarchy-broadcast CLI, for tests/harness/shell.qml. Never
# talks to D-Bus or to a real daemon.
#
# Every invocation appends one line to $FAKE_OB_DIR/log:
#   <pid> [arg1] [arg2] ...
#
# `watch --json`: prints every line of $FAKE_OB_DIR/snapshot (the harness puts
# the "current" snapshot there, plus any hostile lines it wants delivered at
# connection), then follows $FAKE_OB_DIR/feed from its end at start-up,
# printing each line appended to it. The start offset is taken before the
# snapshot is printed, so a line appended once the snapshot has been seen is
# never missed. Exits 0 on SIGTERM/SIGINT, as the real CLI does.
#   - if $FAKE_OB_DIR/snapshot.1 exists, it is written first, then after a
#     pause $FAKE_OB_DIR/snapshot.2: two separate writes, so the reader gets
#     two reads (a line, or a character, cut across a read boundary);
#   - if $FAKE_OB_DIR/watch-exit exists, the watch exits with that status
#     right after the snapshot (a watch that dies after connecting).
#   - camera settings: if $FAKE_OB_DIR/settings-mode exists, every snapshot
#     line it prints (from snapshot or feed) is followed, by the mode's first
#     word, by:
#       list   the settings set of settings-state, as settings_group lines
#              (rev from settings-rev, serial from settings-serial, camera
#              from settings-camera; at most settings-per-line settings a
#              line, default 4, so a group of more is cut into parts)
#       clear  a settings_clear line
#       none   nothing (a daemon below interface revision 7)
#     settings-state holds one setting per line, fields separated by "|":
#       group|group label|id|type|label|value|default|stored|min|max|step|
#       unit|options|master|when|reason|fixed|scope|surface
#     options as value:Label,value:Label (enum); a setting with a master
#     (another setting's id) is enabled only while the master's value is one
#     of `when` (comma-separated), else greyed with `reason`; fixed 1: always
#     greyed (a read-only control); scope "global" (optional, else camera): a
#     setting of the daemon's own, whose groups come after the camera's. With
#     only global rows, settings-camera is empty and the lines carry camera "".
#     surface (optional, interface revision 13): the group's `surface`, read
#     from the group's first row ("mic": the microphone's groups); empty, the
#     group line has none, as before revision 13. An option value may then
#     be a PipeWire node name (alsa_input.usb-...), written as any other.
#     Values: decimal (int), true/false (bool), an option value (enum), -
#     (action).
#     An option value may hold "@" and "/" (interface revision 12's capture
#     modes, `camera.capture.mode`: auto:Automatic,3840x2160@30:3840x2160 · 30 fps,
#     up to 16 options with one labelled "(gone)"); the fake checks a
#     written enum against the options as it is, so a mode is a plain write.
#     A feed line that is exactly {"fake":"settings-set"} is not printed:
#     the settings set is, alone, as the real CLI prints it after a serial
#     change (it reads the settings again, with no snapshot before them).
#
# `preview --json [--fps 15|30]`: as the real CLI's preview stream, without a
# daemon. Any other fps (or argument) is a usage error, exit 2. It writes into
# $XDG_RUNTIME_DIR/omarchy-broadcast/preview.jpg, and refuses (exit 3) any
# XDG_RUNTIME_DIR but the harness's scratch one, $FAKE_OB_DIR/../runtime, so
# the user's real runtime directory is never written. It prints:
#   - the lines of $FAKE_OB_DIR/preview-error, if it exists (an outage);
#   - `{"v":1,"type":"preview","active":true,"fps":N,"path":P}`;
#   - the lines of $FAKE_OB_DIR/preview-hostile, if it exists;
#   - if $FAKE_OB_DIR/preview-exit exists, exits with that status here;
#   - then forever, at the fps: copies the next of $FAKE_OB_DIR/frames/0..3.jpg
#     (real JPEGs, made by run-harness.sh) to P.tmp, renames it onto P, and
#     prints `{"v":1,"type":"frame","seq":N,"path":P}`, seq from 1.
# On SIGTERM/SIGINT/SIGHUP it removes the frame files and exits 0.
#
# `settings set [--camera=ID] -- SETTING VALUE`, `settings reset --camera=ID`
# and `settings reset --setting=ID` (that one setting back to its default,
# stored cleared): as the other commands below (delay, stderr, exit), after a
# usage check (exit 2: any other shape). When the exit status is 0 and
# settings-state exists, it is the daemon: another camera than
# settings-camera for a camera setting (a global one takes no camera and
# ignores one; a reset of the camera leaves the global ones alone), an unknown id, a greyed setting, or a value that is not
# one of the setting's (an int off its range or step, a bool that is not
# true/false, an enum that is not an option, an action value that is not
# true) is refused (exit 1, a message on stderr); otherwise the value is
# stored (reset: every value back to its default, nothing stored), the rev
# moves on, and the settings_delta lines are appended to the feed, as the
# daemon's signal would reach a watch: the setting written and every
# setting whose enabled state changed with it (reset: all, 16 a line).
#
# The setup dialog's reads (interface revisions 9 and 10): `modules list
# --json`, `order show --json`, `config show --json` and `config files
# --json` print $FAKE_OB_DIR/modules-list, order-show, config-show and
# config-files (the harness writes the lines); a missing file is a daemon
# that predates them: an `unsupported-daemon` error line and exit 1. If
# read-exit exists, a read exits with that status after printing.
#
# The setup dialog's writes: `modules enable|disable ID`, `order set
# ID,ID,...`, `order reset`, `config set -- KEY VALUE` and `config reset --
# KEY`: a usage check first (exit 2 for any other shape), then delay, stderr
# and exit as the commands below. When the status is 0 the fake is the
# daemon: `modules enable|disable` flips "enabled" of the module line whose
# module object starts {"id":"ID", ...; `order set` rewrites the order line
# (every stage movable, but the first up and the last down); `config set`
# replaces the "value" of the row that starts {"id":"KEY","value":...
# (true, false and numbers as given, anything else quoted: an output mode
# such as 1920x1080@60, `output.mode` of interface revision 12, is a string;
# an enum written is not checked against its options, the dialog does); then a
# `modules_changed` (modules, order) or `config_changed` (config) line with
# the next serial of $FAKE_OB_DIR/setup-serial is appended to the feed, as
# the daemon's signal would reach a watch.
#
# The microphone (interface revision 13): `mic on`, `mic off`, `mic device
# NAME`, `mic default` and `mic restore-default` (a usage check first, exit
# 2 for any other shape), then delay, stderr and exit as the commands below.
# When the status is 0, `mic on` and `mic off` append a `mic` line to the
# feed (state $FAKE_OB_DIR/mic-on-state, default passthrough, or off, with
# no consumer), as the daemon's MicState change would reach a watch; the
# others change nothing (the plugin writes the settings with `settings set`).
#
# The background gallery (interface revision 15): `media list background
# --json` prints $FAKE_OB_DIR/media-list (the `media` header line and its
# `media_item` lines, as the harness writes them; missing: a daemon that
# predates it, as the setup reads above); `media import background PATH --select` and
# `media remove PATH` (a usage check first, exit 2 for any other shape) then
# delay, stderr and exit as the commands below; an import sleeps
# $FAKE_OB_DIR/import-delay seconds first if that file exists (a slow one:
# converting an animated image or a video), the other commands not. The
# items may be videos (`media_type` "video", a `duration_ms` and a
# `poster`): the fake prints the lines as written. When a remove's status is 0
# and $FAKE_OB_DIR/media-list-removed exists, it replaces media-list (the
# gallery without the item). `effect replace --image PATH` is one of the
# other commands.
#
# The away image's gallery (interface revision 17): `media list away --json`
# prints $FAKE_OB_DIR/media-list-away (missing: as above); `media import away
# PATH --select` (a usage check first), then delay, stderr and exit as above;
# when the status is 0 and config-show exists, the daemon stores the file
# in its gallery and selects it: the value of `effect.fallback_image` in
# config-show becomes $FAKE_OB_DIR/away-user/<the file's name>, and a
# `config_changed` line is appended to the feed. The away image itself is
# set and cleared with `config set -- effect.fallback_image PATH` (or "").
#
# Any other command (`on`, `off`, `camera -- <id>`, `camera next`): sleeps $FAKE_OB_DIR/delay
# seconds if that file exists, prints $FAKE_OB_DIR/stderr to stderr if it
# exists, and exits with the status in $FAKE_OB_DIR/exit (default 0). It
# changes no state: the harness writes the daemon's reaction (a state line
# with `effect`, `blur_strength`, `background_image` and `denoise`, as the
# real CLI prints) to the feed itself, and puts `denoise` in its snapshots
# (or leaves it out, for a CLI that predates noise removal).
set -u

dir=${FAKE_OB_DIR:?FAKE_OB_DIR is not set}
log=$dir/log

{
  printf '%s' "$$"
  for arg in "$@"; do printf ' [%s]' "$arg"; done
  printf '\n'
} >> "$log"

# The awk functions shared by the settings emulation: the state is read
# into f[k, field] (k = 1..n), val[id], typ[id], row[id]; en[k] says whether
# setting k is enabled under the values in val.
# shellcheck disable=SC2016 # an awk program: its $ fields are awk's, not the shell's
SETTINGS_AWK='
function jstr(s) { gsub(/\\/, "\\\\", s); gsub(/"/, "\\\"", s); return "\"" s "\"" }
function jval(t, v) { if (t == "int") return v + 0; if (t == "bool") return (v == "true" ? "true" : "false"); return jstr(v) }
function enabled(k,   m, i, nw, ws) {
  if (f[k, 17] == "1") return 0
  m = f[k, 14]
  if (m == "") return 1
  nw = split(f[k, 15], ws, ",")
  for (i = 1; i <= nw; i++) if (val[m] == ws[i]) return 1
  return 0
}
function setting(k,   s, t, i, n, os, kv, w, nw, ws, mt) {
  t = f[k, 4]
  s = "{\"id\":" jstr(f[k, 3]) ",\"label\":" jstr(f[k, 5]) ",\"type\":" jstr(t) ",\"scope\":\"" (f[k, 18] == "global" ? "global" : "camera") "\",\"stored\":" (f[k, 8] == "1" ? "true" : "false")
  s = s ",\"enabled\":" (en[k] ? "true" : "false") ",\"disabled_reason\":" jstr(en[k] ? "" : f[k, 16])
  w = ""
  if (f[k, 14] != "") {
    mt = typ[f[k, 14]]
    nw = split(f[k, 15], ws, ",")
    if (nw == 1) w = "{\"id\":" jstr(f[k, 14]) ",\"op\":\"eq\",\"value\":" jval(mt, ws[1]) "}"
    else {
      w = "{\"id\":" jstr(f[k, 14]) ",\"op\":\"in\",\"value\":["
      for (i = 1; i <= nw; i++) w = w (i > 1 ? "," : "") jval(mt, ws[i])
      w = w "]}"
    }
  }
  s = s ",\"enabled_when\":[" w "]"
  if (t != "action") s = s ",\"value\":" jval(t, f[k, 6]) ",\"default\":" jval(t, f[k, 7])
  if (t == "int") {
    s = s ",\"min\":" (f[k, 9] + 0) ",\"max\":" (f[k, 10] + 0) ",\"step\":" (f[k, 11] + 0)
    if (f[k, 12] != "") s = s ",\"unit\":" jstr(f[k, 12])
    s = s ",\"hint\":\"slider\""
  }
  if (t == "bool") s = s ",\"hint\":\"switch\""
  if (t == "enum") {
    n = split(f[k, 13], os, ",")
    s = s ",\"options\":["
    for (i = 1; i <= n; i++) { split(os[i], kv, ":"); s = s (i > 1 ? "," : "") "{\"value\":" jstr(kv[1]) ",\"label\":" jstr(kv[2]) "}" }
    s = s "],\"hint\":\"segmented\""
  }
  return s "}"
}
function change(k,   s) {
  s = "{\"id\":" jstr(f[k, 3])
  if (f[k, 4] != "action") s = s ",\"value\":" jval(f[k, 4], f[k, 6])
  return s ",\"stored\":" (f[k, 8] == "1" ? "true" : "false") ",\"enabled\":" (en[k] ? "true" : "false") ",\"disabled_reason\":" jstr(en[k] ? "" : f[k, 16]) "}"
}
function load(   i) { n++; for (i = 1; i <= 19; i++) f[n, i] = $i; val[$3] = $6; typ[$3] = $4; row[$3] = n }
function state_line(k,   i, s) { s = f[k, 1]; for (i = 2; i <= 19; i++) s = s "|" f[k, i]; return s }
'

setting_file() { head -n 1 -- "$dir/$1" 2>/dev/null || echo "$2"; }

# The settings set of settings-state as settings_group lines.
settings_set() {
  awk -F'|' -v camera="$(setting_file settings-camera "")" -v rev="$(setting_file settings-rev 1)" \
      -v serial="$(setting_file settings-serial 1)" -v per="$(setting_file settings-per-line 4)" "$SETTINGS_AWK"'
    NF >= 16 { load() }
    END {
      for (k = 1; k <= n; k++) en[k] = enabled(k)
      lines = 0
      k = 1
      while (k <= n) {
        start = k
        while (k <= n && f[k, 1] == f[start, 1]) k++
        parts = int((k - start + per - 1) / per)
        for (p = 1; p <= parts; p++) {
          lines++
          ls[lines] = start + (p - 1) * per
          le[lines] = start + p * per - 1
          if (le[lines] > k - 1) le[lines] = k - 1
          lp[lines] = p
          lq[lines] = parts
        }
      }
      for (i = 1; i <= lines; i++) {
        s = ""
        for (j = ls[i]; j <= le[i]; j++) s = s (j > ls[i] ? "," : "") setting(j)
        sf = f[ls[i], 19] != "" ? ",\"surface\":" jstr(f[ls[i], 19]) : ""
        printf "{\"v\":1,\"type\":\"settings_group\",\"schema\":1,\"rev\":%d,\"serial\":%d,\"camera\":%s,\"index\":%d,\"count\":%d,\"part\":%d,\"parts\":%d,\"group\":{\"id\":%s,\"label\":%s%s,\"settings\":[%s]}}\n",
          rev, serial, jstr(camera), i - 1, lines, lp[i], lq[i], jstr(f[ls[i], 1]), jstr(f[ls[i], 2]), sf, s
      }
    }' "$dir/settings-state"
}

# After a snapshot line: the settings set, a settings_clear, or nothing.
settings_after_snapshot() {
  case $(setting_file settings-mode none) in
    list) settings_set ;;
    clear) printf '{"v":1,"type":"settings_clear","rev":%s,"serial":%s}\n' "$(setting_file settings-rev 1)" "$(setting_file settings-serial 1)" ;;
  esac
}

# Line $2 of file $1, then what follows a snapshot line (or, for the
# settings-set marker, only the set).
emit_line() {
  if [ -f "$dir/settings-mode" ] && sed -n "${2}p" -- "$1" | grep -qx '{"fake":"settings-set"}'; then
    settings_set
    return
  fi
  sed -n "${2}p" -- "$1"
  if [ -f "$dir/settings-mode" ] && sed -n "${2}p" -- "$1" | grep -q '"type":"snapshot"'; then
    settings_after_snapshot
  fi
}

if [ "${1:-}" = "watch" ] && [ "${2:-}" = "--json" ]; then
  trap 'exit 0' TERM INT
  feed=$dir/feed
  touch "$feed"
  n=$(wc -l < "$feed")
  if [ -f "$dir/snapshot.1" ]; then
    cat "$dir/snapshot.1"
    sleep 0.3
    cat "$dir/snapshot.2" 2>/dev/null
  fi
  if [ -f "$dir/snapshot" ]; then
    lines=$(wc -l < "$dir/snapshot")
    i=0
    while [ "$i" -lt "$lines" ]; do
      i=$((i + 1))
      emit_line "$dir/snapshot" "$i"
    done
  fi
  [ -f "$dir/watch-exit" ] && exit "$(cat "$dir/watch-exit")"
  while :; do
    total=$(wc -l < "$feed")
    while [ "$n" -lt "$total" ]; do
      n=$((n + 1))
      emit_line "$feed" "$n"
    done
    sleep 0.05
  done
fi

if [ "${1:-}" = "settings" ]; then
  case ${2:-} in
    set)
      case $# in
        6) [ "$4" = "--" ] && case $3 in --camera=?*) true ;; *) false ;; esac ;;
        5) [ "$3" = "--" ] ;;
        *) false ;;
      esac || { echo "fake: usage: settings set [--camera=ID] -- SETTING VALUE" >&2; exit 2; } ;;
    reset)
      [ $# -eq 3 ] || { echo "fake: usage: settings reset --camera=ID | --setting=ID" >&2; exit 2; }
      case $3 in --camera=?* | --setting=?*) ;; *) echo "fake: usage: settings reset --camera=ID | --setting=ID" >&2; exit 2 ;; esac ;;
    *) echo "fake: usage: settings set|reset" >&2; exit 2 ;;
  esac
  [ -f "$dir/delay" ] && sleep "$(cat "$dir/delay")"
  [ -f "$dir/stderr" ] && cat "$dir/stderr" >&2
  status=0
  [ -f "$dir/exit" ] && status=$(cat "$dir/exit")
  [ "$status" -eq 0 ] && [ -f "$dir/settings-state" ] || exit "$status"
  state=$dir/settings-state
  # The camera the write names (none: the active one), and the setting it is for.
  camera=$(setting_file settings-camera "")
  active=$camera
  case $3 in --camera=*) camera=${3#--camera=} ;; esac
  only=""
  case $2 in
    set) if [ $# -eq 6 ]; then id=$5 value=$6; else id=$4 value=$5; fi ;;
    *) id="" value=""; case $3 in --setting=*) only=${3#--setting=}; id=$only ;; esac ;;
  esac
  # A camera setting must be written for the active camera; a global one
  # takes no camera and ignores one.
  if ! awk -F'|' -v id="$id" '$3 == id && $18 == "global" { found = 1 } END { exit !found }' "$state"; then
    [ "$camera" = "$active" ] || { echo "omarchy-broadcast: no camera $camera" >&2; exit 1; }
  fi
  camera=$active
  rev=$(($(setting_file settings-rev 1) + 1))
  serial=$(setting_file settings-serial 1)
  deltas=$dir/settings-delta.tmp
  : > "$deltas"
  awk -F'|' -v id="$id" -v value="$value" -v reset="$([ "$2" = reset ] && [ -z "$only" ] && echo 1)" -v only="$only" -v out="$deltas" \
      -v head="{\"v\":1,\"type\":\"settings_delta\",\"schema\":1,\"rev\":$rev,\"serial\":$serial,\"camera\":" \
      -v camera="$camera" "$SETTINGS_AWK"'
    NF >= 16 { load() }
    END {
      for (k = 1; k <= n; k++) before[k] = enabled(k)
      if (reset == "1") {
        for (k = 1; k <= n; k++) if (f[k, 18] != "global") { f[k, 6] = f[k, 7]; f[k, 8] = "0"; val[f[k, 3]] = f[k, 7] }
      } else if (only != "") {
        if (!(only in row)) { print "omarchy-broadcast: no setting " only > "/dev/stderr"; exit 3 }
        k = row[only]
        f[k, 6] = f[k, 7]; f[k, 8] = "0"; val[only] = f[k, 7]
      } else {
        if (!(id in row)) { print "omarchy-broadcast: the camera has no setting " id > "/dev/stderr"; exit 3 }
        k = row[id]
        if (!before[k]) { print "omarchy-broadcast: " f[k, 16] > "/dev/stderr"; exit 4 }
        t = f[k, 4]
        ok = 0
        if (t == "int") ok = value ~ /^-?[0-9]+$/ && value + 0 >= f[k, 9] + 0 && value + 0 <= f[k, 10] + 0 && (value - f[k, 9]) % f[k, 11] == 0
        else if (t == "bool") ok = value == "true" || value == "false"
        else if (t == "action") ok = value == "true"
        else { no = split(f[k, 13], os, ","); for (i = 1; i <= no; i++) { split(os[i], kv, ":"); if (kv[1] == value) ok = 1 } }
        if (!ok) { print "omarchy-broadcast: invalid value " value " for " id > "/dev/stderr"; exit 5 }
        if (t != "action") { f[k, 6] = (t == "int" ? value + 0 : value); f[k, 8] = "1"; val[id] = f[k, 6] }
      }
      for (k = 1; k <= n; k++) en[k] = enabled(k)
      m = 0
      for (k = 1; k <= n; k++) if ((reset == "1" && f[k, 18] != "global") || f[k, 3] == id || en[k] != before[k]) { m++; ch[m] = change(k) }
      for (i = 1; i <= m; i += 16) {
        s = ""
        for (j = i; j <= m && j < i + 16; j++) s = s (j > i ? "," : "") ch[j]
        print head jstr(camera) ",\"changes\":[" s "]}" > out
      }
      for (k = 1; k <= n; k++) print state_line(k)
    }' "$state" > "$state.tmp"
  case $? in
    0) ;;
    *) rm -f -- "$state.tmp" "$deltas"; exit 1 ;;
  esac
  mv -f -- "$state.tmp" "$state"
  echo "$rev" > "$dir/settings-rev"
  cat "$deltas" >> "$dir/feed"
  rm -f -- "$deltas"
  exit 0
fi

# The setup reads: the file's lines, or a daemon that predates them.
setup_read() {
  if [ -f "$dir/$1" ]; then
    cat -- "$dir/$1"
  else
    printf '{"v":1,"type":"error","code":"unsupported-daemon","error":"the daemon does not support this (its interface revision is 8)"}\n'
    exit 1
  fi
  [ -f "$dir/read-exit" ] && exit "$(cat "$dir/read-exit")"
  exit 0
}

case "${1:-} ${2:-} ${3:-}" in
  "modules list --json") [ $# -eq 3 ] && setup_read modules-list ;;
  "order show --json") [ $# -eq 3 ] && setup_read order-show ;;
  "config show --json") [ $# -eq 3 ] && setup_read config-show ;;
  "config files --json") [ $# -eq 3 ] && setup_read config-files ;;
esac

# A setup write's reaction: the next serial, on a line of `type`.
setup_changed() {
  serial=$(($(setting_file setup-serial 1) + 1))
  echo "$serial" > "$dir/setup-serial"
  printf '{"v":1,"type":"%s","serial":%s}\n' "$1" "$serial" >> "$dir/feed"
}

# config-show with the "value" of the row that starts {"id":"KEY","value":...
# replaced by VALUE (JSON as given).
set_config_value() {
  awk -v key="$1" -v value="$2" '{
    head = "{\"id\":\"" key "\",\"value\":"
    at = index($0, head)
    if (at > 0) {
      rest = substr($0, at + length(head))
      cut = index(rest, ",\"")
      $0 = substr($0, 1, at - 1) head value substr(rest, cut)
    }
    print
  }' "$dir/config-show" > "$dir/config-show.tmp" && mv -f -- "$dir/config-show.tmp" "$dir/config-show"
}

if [ "${1:-}" = "media" ]; then
  case "${2:-} ${3:-}" in
    "list background") [ $# -eq 4 ] && [ "$4" = "--json" ] && setup_read media-list ;;
    "list away") [ $# -eq 4 ] && [ "$4" = "--json" ] && setup_read media-list-away ;;
    "import background" | "import away") [ $# -eq 5 ] && [ "$5" = "--select" ] ;;
    "remove "?*) [ $# -eq 3 ] ;;
    *) false ;;
  esac || { echo "fake: usage: media list background|away --json | import background|away PATH --select | remove PATH" >&2; exit 2; }
  [ "$2" = import ] && [ -f "$dir/import-delay" ] && sleep "$(cat "$dir/import-delay")"
  [ -f "$dir/delay" ] && sleep "$(cat "$dir/delay")"
  [ -f "$dir/stderr" ] && cat "$dir/stderr" >&2
  status=0
  [ -f "$dir/exit" ] && status=$(cat "$dir/exit")
  [ "$status" -eq 0 ] || exit "$status"
  if [ "$2" = remove ] && [ -f "$dir/media-list-removed" ]; then
    mv -f -- "$dir/media-list-removed" "$dir/media-list"
  fi
  if [ "$2" = import ] && [ "$3" = away ] && [ -f "$dir/config-show" ]; then
    set_config_value effect.fallback_image "\"$dir/away-user/$(basename -- "$4")\""
    setup_changed config_changed
  fi
  exit 0
fi

setup_write=""
case ${1:-} in
  modules)
    case ${2:-} in
      enable | disable) [ $# -eq 3 ] && setup_write=$2 ;;
    esac ;;
  order)
    case ${2:-} in
      set) [ $# -eq 3 ] && setup_write=order-set ;;
      reset) [ $# -eq 2 ] && setup_write=order-reset ;;
    esac ;;
  config)
    case ${2:-} in
      set) [ $# -eq 5 ] && [ "$3" = "--" ] && setup_write=config-set ;;
      reset) [ $# -eq 4 ] && [ "$3" = "--" ] && setup_write=config-reset ;;
    esac ;;
esac
case ${1:-} in
  modules | order | config)
    [ -n "$setup_write" ] || { echo "fake: usage: $*" >&2; exit 2; }
    [ -f "$dir/delay" ] && sleep "$(cat "$dir/delay")"
    [ -f "$dir/stderr" ] && cat "$dir/stderr" >&2
    status=0
    [ -f "$dir/exit" ] && status=$(cat "$dir/exit")
    [ "$status" -eq 0 ] || exit "$status"
    case $setup_write in
      enable | disable)
        [ -f "$dir/modules-list" ] && {
          on=true
          [ "$setup_write" = disable ] && on=false
          awk -v id="$3" -v on="$on" 'index($0, "\"module\":{\"id\":\"" id "\"") { sub(/"enabled":(true|false)/, "\"enabled\":" on) } { print }' \
            "$dir/modules-list" > "$dir/modules-list.tmp" && mv -f -- "$dir/modules-list.tmp" "$dir/modules-list"
        }
        setup_changed modules_changed ;;
      order-set)
        printf '%s\n' "$3" | awk -F, '{
          s = ""; o = ""
          for (i = 1; i <= NF; i++) {
            o = o (i > 1 ? "," : "") "\"" $i "\""
            s = s (i > 1 ? "," : "") "{\"id\":\"" $i "\",\"slot\":\"pre-matte\",\"up\":" (i > 1 ? "true" : "false") ",\"down\":" (i < NF ? "true" : "false") "}"
          }
          printf "{\"v\":1,\"type\":\"order\",\"order\":[%s],\"order_truncated\":false,\"stages\":[%s],\"overridden_by\":\"\"}\n", o, s
        }' > "$dir/order-show"
        setup_changed modules_changed ;;
      order-reset) setup_changed modules_changed ;;
      config-set)
        case $5 in
          true | false) value=$5 ;;
          *) if printf '%s' "$5" | grep -Eq '^-?[0-9]+(\.[0-9]+)?$'; then value=$5; else value="\"$5\""; fi ;;
        esac
        [ -f "$dir/config-show" ] && set_config_value "$4" "$value"
        setup_changed config_changed ;;
      config-reset) setup_changed config_changed ;;
    esac
    exit 0 ;;
esac

if [ "${1:-}" = "mic" ]; then
  case "${2:-}" in
    on | off | default | restore-default) [ $# -eq 2 ] ;;
    device) [ $# -eq 3 ] ;;
    *) false ;;
  esac || { echo "fake: usage: mic on|off|device NAME|default|restore-default" >&2; exit 2; }
  [ -f "$dir/delay" ] && sleep "$(cat "$dir/delay")"
  [ -f "$dir/stderr" ] && cat "$dir/stderr" >&2
  status=0
  [ -f "$dir/exit" ] && status=$(cat "$dir/exit")
  [ "$status" -eq 0 ] || exit "$status"
  case $2 in
    on) printf '{"v":1,"type":"mic","state":"%s","consumers":0,"provider":"","latency_ms":0,"error":""}\n' "$(setting_file mic-on-state passthrough)" >> "$dir/feed" ;;
    off) printf '{"v":1,"type":"mic","state":"off","consumers":0,"provider":"","latency_ms":0,"error":""}\n' >> "$dir/feed" ;;
  esac
  exit 0
fi

if [ "${1:-}" = "preview" ]; then
  [ "${2:-}" = "--json" ] || { echo "fake: preview needs --json" >&2; exit 2; }
  fps=15
  if [ $# -gt 2 ]; then
    [ $# -eq 4 ] && [ "$3" = "--fps" ] || { echo "fake: usage: preview --json [--fps 15|30]" >&2; exit 2; }
    fps=$4
  fi
  case $fps in
    15) delay=0.066 ;;
    30) delay=0.033 ;;
    *) echo "fake: invalid value '$fps' for '--fps'" >&2; exit 2 ;;
  esac
  rt=${XDG_RUNTIME_DIR:-}
  [ -n "$rt" ] && [ "$rt" = "$(dirname -- "$dir")/runtime" ] || { echo "fake: refusing XDG_RUNTIME_DIR=$rt" >&2; exit 3; }
  out=$rt/omarchy-broadcast
  mkdir -p -- "$out" && chmod 700 -- "$out" || exit 1
  path=$out/preview.jpg
  trap 'rm -f -- "$path" "$path.tmp"; exit 0' TERM INT HUP
  [ -f "$dir/preview-error" ] && cat "$dir/preview-error"
  printf '{"v":1,"type":"preview","active":true,"fps":%s,"path":"%s"}\n' "$fps" "$path"
  [ -f "$dir/preview-hostile" ] && cat "$dir/preview-hostile"
  [ -f "$dir/preview-exit" ] && exit "$(cat "$dir/preview-exit")"
  n=0
  while :; do
    n=$((n + 1))
    cp -- "$dir/frames/$((n % 4)).jpg" "$path.tmp" && mv -f -- "$path.tmp" "$path" || exit 1
    printf '{"v":1,"type":"frame","seq":%s,"path":"%s"}\n' "$n" "$path"
    sleep "$delay"
  done
fi

[ -f "$dir/delay" ] && sleep "$(cat "$dir/delay")"
[ -f "$dir/stderr" ] && cat "$dir/stderr" >&2
status=0
[ -f "$dir/exit" ] && status=$(cat "$dir/exit")
exit "$status"
